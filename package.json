{
  "name": "quitt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "db:local": "wrangler d1 migrations apply quitt --local",
    "db:remote": "wrangler d1 migrations apply quitt --remote",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.128.0"
  }
}
